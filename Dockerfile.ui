FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

WORKDIR /ui
COPY requirements.ui.txt ./
RUN pip install --no-cache-dir -r requirements.ui.txt

COPY ui ./ui

RUN useradd --create-home --uid 10001 appuser && chown -R appuser /ui
USER appuser

EXPOSE 8501
# $PORT lets hosting platforms pick the port; defaults to 8501
CMD ["sh", "-c", "python -m streamlit run ui/streamlit_app.py --server.port ${PORT:-8501} --server.address 0.0.0.0"]
